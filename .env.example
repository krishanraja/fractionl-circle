# ─── Frontend (Vite) ────────────────────────────────────────────────────
# Exposed in the client bundle. Only put public-safe values here.
# Prefer the Supabase custom auth domain in production so the Google sign-in
# consent screen reads "continue to auth.circle.fractionl.ai" instead of the
# raw <ref>.supabase.co host. See docs/supabase-custom-domain.md.
VITE_SUPABASE_URL="https://auth.circle.fractionl.ai"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# Stripe price IDs (public, referenced in the billing UI)
VITE_STRIPE_PRO_MONTHLY_PRICE_ID="price_..."
VITE_STRIPE_PRO_ANNUAL_PRICE_ID="price_..."
VITE_STRIPE_EXEC_MONTHLY_PRICE_ID="price_..."
VITE_STRIPE_EXEC_ANNUAL_PRICE_ID="price_..."


# ─── Edge Function Secrets (Supabase) ───────────────────────────────────
# Never commit real values. Set these via `supabase secrets set` or the
# Supabase dashboard. Functions read them via Deno.env.get().

# Supabase runtime (auto-injected by the platform, listed for reference)
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY

# AI providers
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
LOVABLE_API_KEY=""

# Contact enrichment (optional)
CLEARBIT_API_KEY=""
APOLLO_API_KEY=""

# Google (OAuth + CSE for LinkedIn search)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_CREDENTIALS=""
GOOGLE_SEARCH_API_KEY=""
GOOGLE_CSE_ID=""

# Microsoft (OAuth — legacy MS_* names still read for backward compat)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_TENANT=""

# Stripe (server-side)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_IDS=""
STRIPE_EXEC_PRICE_IDS=""

# Twilio (SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Concierge notification channel
CONCIERGE_SLACK_WEBHOOK_URL=""
CONCIERGE_OPS_EMAIL=""
CONCIERGE_FROM_EMAIL=""
RESEND_API_KEY=""

# Cron auth (must match the x-cron-secret header sent by schedulers)
CRON_SECRET=""

# Deployed URL, used for OAuth callback construction
APP_URL="https://circle.fractionl.ai"

# The Path Room (re-visioned product). Default off; set true to expose /path.
VITE_PATH_ROOM_ENABLED=false
