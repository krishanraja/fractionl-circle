{
  "manifest_version": 3,
  "name": "Circle - LinkedIn Capture",
  "short_name": "Circle",
  "version": "0.1.0",
  "description": "Client-side capture of LinkedIn profiles into your Circle. No scraping of anyone else's data - only pages you're actively viewing in your own session.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_title": "Circle",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["content-linkedin.js"],
      "run_at": "document_idle"
    }
  ]
}
